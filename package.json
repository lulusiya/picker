{
  "name": "vite-plugin-picker",
  "version": "0.3.0",
  "description": "Alt-click a DOM element in Vite dev mode and generate an AI-ready source prompt.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "picker-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mcp.ts --format esm,cjs --dts --clean",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "vue",
    "vue3",
    "react",
    "jsx",
    "developer-tools",
    "ai",
    "mcp",
    "prompt"
  ],
  "license": "MIT",
  "author": "lihuohuo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lulusiya/vite-plugin-picker.git"
  },
  "homepage": "https://github.com/lulusiya/vite-plugin-picker#readme",
  "bugs": {
    "url": "https://github.com/lulusiya/vite-plugin-picker/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "vite": ">=5.0.0",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@vue/compiler-dom": "^3.5.0",
    "@vue/compiler-sfc": "^3.5.0",
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zod": "^4.6.5"
  }
}
